# ============================================================
# SentinelOps AI
# Environment Variable Template
# ============================================================

# Application
SENTINELOPS_ENV=development
SENTINELOPS_LOG_LEVEL=INFO
SENTINELOPS_HOST=127.0.0.1
SENTINELOPS_PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OpenTelemetry
OTEL_SERVICE_NAME=sentinelops-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Grafana
GRAFANA_URL=http://localhost:3000

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# SentinelGuard
SENTINELGUARD_MODE=recommend_only
SENTINELGUARD_AUTO_EXECUTE=false

# Security
SENTINELOPS_SECRET_KEY=CHANGE_ME