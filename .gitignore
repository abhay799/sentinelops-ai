# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime logs
*.log
logs/

# Generated telemetry / datasets
data/telemetry/raw/
data/processed/
data/tmp/
data/cache/

# Generated ML models
models/**/*.joblib
models/**/*.pkl
models/**/*.pickle
models/**/*.onnx

# Generated artifacts
artifacts/
reports/generated/

# Coverage
.coverage
htmlcov/
coverage.xml

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp
~*

# Python package metadata
*.egg-info/

